// QuantPilot - Prisma Schema (PostgreSQL)
// 本地开发默认使用 Docker 中的 TimescaleDB/PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Core Models
// ============================================================

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("idle") // idle, running, stopped, error

  // Preview (legacy metadata retained for compatibility)
  previewUrl  String?  @map("preview_url")
  previewPort Int?     @map("preview_port")

  // Repository
  repoPath    String?  @map("repo_path")

  // Initial setup
  initialPrompt String? @map("initial_prompt")
  templateType  String? @map("template_type") // nextjs, react, vue 等

  // AI Session Management
  activeClaudeSessionId String? @map("active_claude_session_id")
  activeCursorSessionId String? @map("active_cursor_session_id")

  // CLI Preferences
  preferredCli  String? @map("preferred_cli") // claude, cursor, codex, gemini, qwen
  selectedModel String? @map("selected_model") // 前端选择的模型 ID，例如 mimo-v2.5-pro
  fallbackEnabled Boolean @default(false) @map("fallback_enabled")

  // Settings (JSON)
  settings    String? // JSON string for additional settings

  // Timestamps
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  // Relations
  messages              Message[]
  sessions              Session[]
  envVars               EnvVar[]
  serviceConnections    ProjectServiceConnection[]
  commits               Commit[]
  toolUsages            ToolUsage[]
  userRequests          UserRequest[]

  @@map("projects")
}

model Message {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")

  // Message content
  role         String // user, assistant, system, tool
  messageType  String @map("message_type") // chat, thinking, tool_use, tool_result, error
  content      String // Message content (text, markdown, code)
  metadataJson String? @map("metadata_json") // JSON string for tool info, etc.

  // Thread support
  parentMessageId String? @map("parent_message_id")

  // Session
  sessionId      String? @map("session_id")
  conversationId String? @map("conversation_id")

  // Performance tracking
  durationMs Int? @map("duration_ms")
  tokenCount Int? @map("token_count")
  costUsd    Float? @map("cost_usd")

  // Git integration
  commitSha String? @map("commit_sha")

  // CLI source
  cliSource String? @map("cli_source") // claude, cursor, etc.

  // Request ID for client-server message matching
  requestId String? @map("request_id")

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id])
  toolUsages ToolUsage[]

  @@index([projectId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([cliSource])
  @@index([requestId])
  @@map("messages")
}

model Session {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")

  // Session info
  sessionType String   @map("session_type") // chat, code_gen, error_fix
  cliType     String   @map("cli_type") // claude, cursor, codex, gemini, qwen
  sessionId   String   @map("session_id") // Actual CLI session ID
  modelName   String?  @map("model_name")

  // Context
  contextTokens Int?   @map("context_tokens")

  // Status
  status    String   @default("active") // active, ended, error

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  endedAt   DateTime? @map("ended_at")

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@index([cliType])
  @@map("sessions")
}

model ProjectServiceConnection {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")

  // Service info
  provider     String // github, vercel, supabase
  status       String @default("connected") // connected, disconnected, error

  // Service data (JSON)
  // GitHub: { repo_url, repo_name, default_branch }
  // Vercel: { deployment_url, project_id, auto_deploy }
  // Supabase: { project_url, project_id, database_name }
  serviceData  String @map("service_data")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lastSyncAt  DateTime? @map("last_sync_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([provider])
  @@map("project_service_connections")
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")

  // Environment variable
  key            String
  valueEncrypted String  @map("value_encrypted") // AES-256 encrypted
  scope          String  @default("runtime") // runtime, build, preview
  varType        String  @default("string") @map("var_type") // string, number, boolean, json
  isSecret       Boolean @default(true) @map("is_secret")
  description    String?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
  @@map("env_vars")
}

model Commit {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")

  // Commit info
  sha         String
  message     String
  authorName  String  @map("author_name")
  authorEmail String  @map("author_email")

  // Timestamp
  committedAt DateTime @map("committed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([committedAt])
  @@map("commits")
}

model ToolUsage {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  messageId  String?  @map("message_id")

  // Tool info
  toolName   String   @map("tool_name") // Read, Write, Edit, Bash, etc.
  toolInput  String   @map("tool_input") // JSON string
  toolOutput String?  @map("tool_output")
  error      String?

  // Performance
  durationMs Int?     @map("duration_ms")

  // Timestamp
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id])

  @@index([projectId])
  @@index([messageId])
  @@index([toolName])
  @@map("tool_usages")
}

model UserRequest {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")

  // Request info
  instruction    String
  cliPreference  String?  @map("cli_preference")
  status         String   @default("pending") // pending, processing, completed, failed
  errorMessage   String?  @map("error_message")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("user_requests")
}

// ============================================================
// Service Tokens (Local Development Only)
// ============================================================

model ServiceToken {
  id       String   @id @default(cuid())

  // Service info
  provider String // github, vercel, supabase, deepseek
  name     String // User-defined name
  token    String // Desktop stores a DPAPI reference; server deployments use environment-backed secrets.

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastUsed  DateTime? @map("last_used")

  @@index([provider])
  @@map("service_tokens")
}

// ============================================================
// Platform Settings
// ============================================================

model PlatformSetting {
  key       String   @id
  value    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ============================================================
// Strategy Platform State
// ============================================================

model StrategyScanRun {
  id           String   @id
  templateId   String   @map("template_id")
  scanId       String   @map("scan_id")
  symbol       String
  status       String
  startedAt    DateTime @map("started_at")
  completedAt  DateTime @map("completed_at")
  total        Int
  succeeded    Int
  failed       Int
  bestResultId String?  @map("best_result_id")
  objective    String
  source       String
  results      Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  jobs StrategyScanJob[]

  @@index([templateId])
  @@index([scanId])
  @@index([completedAt])
  @@map("strategy_scan_runs")
}

model StrategyScanJob {
  id          String   @id
  templateId  String   @map("template_id")
  scanId      String   @map("scan_id")
  symbol      String
  status      String
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  runId       String?   @map("run_id")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  run StrategyScanRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([scanId])
  @@index([status])
  @@index([createdAt])
  @@map("strategy_scan_jobs")
}

// ============================================================
// Research Automation State
// ============================================================

model ResearchWatchlist {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  universeId             String?  @map("universe_id")
  symbols                Json
  markets                Json
  status                 String   @default("active")
  schedule               Json
  reportTemplate         String   @default("daily_brief") @map("report_template")
  notificationChannelIds Json     @map("notification_channel_ids")
  metadata               Json
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  runs    ResearchReportRun[]
  reports ResearchReport[]

  @@index([status])
  @@index([updatedAt])
  @@map("research_watchlists")
}

model ResearchReportRun {
  id           String    @id @default(cuid())
  watchlistId  String?   @map("watchlist_id")
  status       String
  runType      String    @map("run_type")
  scheduledFor DateTime? @map("scheduled_for")
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  model        String?
  providerMode String    @default("local") @map("provider_mode")
  metadata     Json
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  watchlist  ResearchWatchlist?   @relation(fields: [watchlistId], references: [id], onDelete: SetNull)
  reports    ResearchReport[]
  deliveries NotificationDelivery[]

  @@index([watchlistId])
  @@index([status])
  @@index([startedAt])
  @@map("research_report_runs")
}

model ResearchReport {
  id              String   @id @default(cuid())
  runId           String   @map("run_id")
  watchlistId     String?  @map("watchlist_id")
  title           String
  summary         String
  reportDate      DateTime @map("report_date")
  marketScope     Json     @map("market_scope")
  score           Int
  recommendation  String
  riskLevel       String   @map("risk_level")
  contentMarkdown String   @map("content_markdown")
  structured      Json
  evidence        Json
  source          String   @default("local-market-data")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  run        ResearchReportRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  watchlist  ResearchWatchlist?      @relation(fields: [watchlistId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([runId])
  @@index([watchlistId])
  @@index([reportDate])
  @@map("research_reports")
}

model NotificationChannel {
  id          String   @id @default(cuid())
  name        String
  channelType String   @map("channel_type")
  status      String   @default("configured")
  target      String?
  config      Json
  isDryRun    Boolean  @default(true) @map("is_dry_run")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@index([channelType])
  @@index([status])
  @@map("notification_channels")
}

model NotificationDelivery {
  id          String    @id @default(cuid())
  runId       String?   @map("run_id")
  reportId    String?   @map("report_id")
  channelId   String?   @map("channel_id")
  status      String
  channelType String    @map("channel_type")
  title       String
  payload     Json
  error       String?
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  run     ResearchReportRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)
  report  ResearchReport?     @relation(fields: [reportId], references: [id], onDelete: SetNull)
  channel NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([reportId])
  @@index([channelId])
  @@index([status])
  @@index([createdAt])
  @@map("notification_deliveries")
}

// ============================================================
// Evaluation Platform State
// ============================================================

model EvalRun {
  id            String   @id
  fileName      String   @map("file_name")
  filePath      String   @map("file_path")
  reportCreatedAt DateTime @map("report_created_at")
  mtimeMs       Float    @map("mtime_ms")
  passed        Boolean
  total         Int
  passedCount   Int      @map("passed_count")
  failedCount   Int      @map("failed_count")
  passRate      Int      @map("pass_rate")
  averageScore  Int      @map("average_score")
  durationMs    Int      @map("duration_ms")
  metadata      Json
  coverage      Json
  results       Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([reportCreatedAt])
  @@index([passed])
  @@map("eval_runs")
}

model EvalQueueItem {
  id              String   @id
  status          String
  cli             String
  model           String
  reasoningEffort String   @map("reasoning_effort")
  selectedCases   Json     @map("selected_cases")
  limit           Int?
  keepProjects    Boolean  @map("keep_projects")
  reportId        String?  @map("report_id")
  reportPath      String?  @map("report_path")
  logPath         String?  @map("log_path")
  pid             Int?
  exitCode        Int?     @map("exit_code")
  error           String?
  createdAt       DateTime @map("created_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("eval_queue_items")
}

model EvalRepairTicket {
  id                  String   @id
  runId               String   @map("run_id")
  caseId              String   @map("case_id")
  title               String
  status              String
  severity            String
  model               String
  reportPath          String   @map("report_path")
  projectId           String?  @map("project_id")
  failures            Json
  validationSummaries Json     @map("validation_summaries")
  suggestedActions    Json     @map("suggested_actions")
  skillVersions       Json     @map("skill_versions")
  createdAt           DateTime @map("created_at")
  updatedAt           DateTime @map("updated_at")

  @@index([runId])
  @@index([caseId])
  @@index([status])
  @@index([createdAt])
  @@map("eval_repair_tickets")
}

model EvalSchedule {
  id              String   @id
  enabled         Boolean
  intervalHours   Int      @map("interval_hours")
  cli             String
  model           String
  reasoningEffort String   @map("reasoning_effort")
  selectedCases   Json     @map("selected_cases")
  limit           Int?
  keepProjects    Boolean  @map("keep_projects")
  nextRunAt       DateTime? @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  lastQueuedRunId String?  @map("last_queued_run_id")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("eval_schedules")
}

// ============================================================
// Optional official-server connection for desktop diagnostics
// ============================================================

model DesktopAccount {
  id                 String    @id @default(cuid())
  usernameNormalized String    @unique @map("username_normalized")
  passwordHash       String    @map("password_hash")
  status             String    @default("active")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  tokenVersion       Int       @default(1) @map("token_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastLoginAt        DateTime? @map("last_login_at")
  passwordChangedAt  DateTime  @default(now()) @map("password_changed_at")

  sessions   DesktopSession[]
  diagnostics DesktopDiagnosticEvent[]

  @@index([status])
  @@map("desktop_accounts")
}

model DesktopSession {
  id               String    @id @default(cuid())
  accountId        String    @map("account_id")
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  installationId   String    @map("installation_id")
  tokenVersion     Int       @map("token_version")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  account DesktopAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([installationId])
  @@index([refreshExpiresAt])
  @@map("desktop_sessions")
}

model DesktopDiagnosticEvent {
  id               String   @id @default(cuid())
  accountId        String   @map("account_id")
  installationId   String   @map("installation_id")
  appVersion       String   @map("app_version")
  windowsVersion   String   @map("windows_version")
  architecture     String
  appSchemaVersion Int      @map("app_schema_version")
  marketSchemaVersion Int   @map("market_schema_version")
  feature          String
  errorCode        String   @map("error_code")
  severity         String
  sanitizedStack   String?  @map("sanitized_stack")
  occurredAt       DateTime @map("occurred_at")
  durationMs       Int?     @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  account DesktopAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([installationId])
  @@index([createdAt])
  @@map("desktop_diagnostic_events")
}

model AnalysisEstimate {
  id          String    @id
  kind        String
  fingerprint String
  payload     Json
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("analysis_estimates")
}
